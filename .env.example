# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Cloudflare R2
VITE_CLOUDFLARE_ACCOUNT_ID=your-account-id
VITE_CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
VITE_CLOUDFLARE_ACCESS_KEY_SECRET=your-access-key-secret
VITE_CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# NVIDIA AI API Keys (for document analysis and chat)
# Get free API keys from: https://build.nvidia.com/
VITE_NVIDIA_API_KEY_1=your-nvidia-api-key-1
VITE_NVIDIA_API_KEY_2=your-nvidia-api-key-2

# YouTube Data API v3
VITE_YOUTUBE_API_KEY=your-youtube-api-key
VITE_YOUTUBE_API_KEY_2=your-youtube-api-key-2

# Google Calendar Integration
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
