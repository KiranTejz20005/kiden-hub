# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Cloudflare R2 Configuration
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
VITE_CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id_here
VITE_CLOUDFLARE_ACCESS_KEY_SECRET=your_r2_access_key_secret_here
VITE_CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name_here

# NVIDIA AI API Keys (for document analysis and chat)
# Get free API keys from: https://build.nvidia.com/
# You can add 2 keys for fallback support - if key1 fails, key2 will be used
VITE_NVIDIA_API_KEY_1=your_nvidia_api_key_1_here
VITE_NVIDIA_API_KEY_2=your_nvidia_api_key_2_here_optional

